<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Bottom navigation for the signed-in section.

        MainActivity hides it on the screens that are not tabs - onboarding,
        auth, the join screen and an open chat - so those keep the full height.
        When it is GONE, ConstraintLayout resolves the nav host bottom to the
        same edge, so the host simply fills the screen.

        Item ids in bottom_nav_menu.xml match destination ids in the nav graph;
        that pairing is what NavigationUI uses to switch tabs.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <!--
        Brand intro overlay - sits on top of the nav host and plays
        res/raw/brand_intro.mp4, then fades away to reveal the app.

        This is deliberately an overlay inside MainActivity rather than a
        separate splash Activity or a nav-graph destination. Google's guidance
        is explicit that a dedicated splash Activity duplicates splash screens
        and slows startup; keeping it here means there is no Activity
        transition between the system splash and the video.

        It starts VISIBLE so it is painted on the very first frame - if it
        started GONE the login screen could flash before the video appeared.
        MainActivity hides it immediately on configuration changes.

        clickable/focusable keep touches from reaching the fragment underneath
        and give us tap-to-skip.
    -->
    <!--
        elevation, not just child order, is what keeps this above the bottom
        bar. BottomNavigationView sets its own elevation, and on Android a
        higher-elevation sibling draws on top no matter which was declared
        last - which is why the bar was visible through the brand intro.
    -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:elevation="24dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/konecta_yellow"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            TextureView, not SurfaceView / VideoView. A SurfaceView punches a
            hole through the window and shows one black frame before the
            decoder delivers its first frame - that black flash is the single
            most common cause of a splash looking like two screens.
        -->
        <TextureView
            android:id="@+id/splash_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
