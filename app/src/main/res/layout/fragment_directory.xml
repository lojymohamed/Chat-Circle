<?xml version="1.0" encoding="utf-8"?>
<!--
    Directory: rooms and people behind two tabs, with a search field.

    One RecyclerView is shared between the tabs rather than a ViewPager2 with
    two child fragments. The two lists never appear at once and neither holds
    scroll state worth preserving, so a pager would add two fragments and their
    lifecycles to save nothing. The trade is that tabs cannot be swiped between,
    only tapped.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".ui.directory.DirectoryFragment">

    <TextView
        android:id="@+id/directoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/poppinsbold"
        android:text="@string/directory_title"
        android:textColor="@color/konecta_blue"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/konecta_neutral"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/directoryTitle">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/poppins"
            android:hint="@string/directory_search"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:singleLine="true"
            android:textColor="@color/konecta_ink"
            android:textColorHint="@color/konecta_muted"
            android:textSize="15sp" />

    </com.google.android.material.card.MaterialCardView>

    <!--
        Our own segmented control rather than a Material TabLayout.

        TabLayout brings its own typography, ripple and indicator, none of which
        match the rest of the app, and overriding all three costs more than
        drawing two TextViews. The selected pill is just a background swap - see
        DirectoryFragment.selectTab().
    -->
    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard">

        <TextView
            android:id="@+id/tabRooms"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppinssemibold"
            android:gravity="center"
            android:text="@string/directory_tab_rooms"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabPeople"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:text="@string/directory_tab_people"
            android:textColor="@color/konecta_muted"
            android:textSize="15sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/directoryList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        tools:itemCount="6"
        tools:listitem="@layout/item_person_row" />

    <TextView
        android:id="@+id/directoryEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:text="@string/directory_empty"
        android:textColor="@color/konecta_muted"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/directoryList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/directoryList"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
