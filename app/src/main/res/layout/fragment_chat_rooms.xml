<?xml version="1.0" encoding="utf-8"?>
<!--
    Home: create or join a room, see who else is around, then your rooms.

    Order is deliberate. The two actions sit at the top because they are why
    someone opens a brand new account; People comes next because it is the
    shortest path to a conversation; the room list is last and gets the rest of
    the screen because it is what a returning user actually scrolls.

    View ids are load-bearing - ChatRoomFragment binds toolbar, roomNameInput,
    createRoomButton, joinRoomButton, roomsRecyclerView, peopleRecyclerView,
    statusText and loadingSpinner.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/konecta_blue_soft"
    android:fitsSystemWindows="true"
    tools:context=".ui.rooms.ChatRoomFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/konecta_blue_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/rooms_menu"
        app:title="@string/app_name"
        app:titleCentered="false"
        app:titleTextColor="@color/konecta_ink" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- Create / join -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardBackgroundColor="@color/konecta_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/konecta_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.ChatCircle.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/home_room_name_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/roomNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:paddingVertical="15dp"
                            android:singleLine="true"
                            android:textColor="@color/konecta_ink"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/createRoomButton"
                        style="@style/Widget.ChatCircle.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/home_create_room" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/joinRoomButton"
                        style="@style/Widget.ChatCircle.Button.Social"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/home_join_room"
                        android:textColor="@color/konecta_blue" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- People -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="26dp"
                android:text="@string/home_people"
                android:textAppearance="@style/TextAppearance.ChatCircle.SectionHeader" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/peopleRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_person" />

            <TextView
                android:id="@+id/peopleEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:text="@string/home_no_people"
                android:textColor="@color/konecta_muted"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Rooms -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="26dp"
                android:text="@string/home_your_rooms"
                android:textAppearance="@style/TextAppearance.ChatCircle.SectionHeader" />

            <!--
                nestedScrollingEnabled is false because this list is inside a
                NestedScrollView: it must lay out at full height and let the
                parent do the scrolling, or the two fight over the gesture.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/roomsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="14dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_chat_room" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:textColor="@color/konecta_muted"
                android:textSize="14sp"
                tools:text="@string/home_no_rooms" />

            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
