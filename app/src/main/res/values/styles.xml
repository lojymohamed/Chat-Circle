<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared widget styling for the Konecta look.

    Specific Poppins weights are referenced directly (@font/poppinssemibold
    rather than a weight attribute) because android:textFontWeight needs API 28
    and this app supports API 24.
-->
<resources>

    <!-- Primary action: solid Konecta blue, generous tap target. -->
    <style name="Widget.ChatCircle.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/konecta_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/poppinssemibold</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary action: white card with a hairline border, e.g. Google sign-in. -->
    <style name="Widget.ChatCircle.Button.Social" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/konecta_surface</item>
        <item name="strokeColor">@color/konecta_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/konecta_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/poppinsmedium</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
    </style>

    <!-- Outlined input with rounded corners, on white. -->
    <style name="Widget.ChatCircle.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/konecta_surface</item>
        <item name="boxStrokeColor">@color/konecta_blue</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/konecta_blue</item>
        <item name="android:textColorHint">@color/konecta_muted</item>
        <item name="endIconTint">@color/konecta_muted</item>
        <item name="errorTextColor">@color/konecta_error</item>
        <item name="boxStrokeErrorColor">@color/konecta_error</item>
    </style>

    <!-- Screen title, e.g. "Welcome back". -->
    <style name="TextAppearance.ChatCircle.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/poppinsbold</item>
        <item name="android:textColor">@color/konecta_ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Supporting line under a title. -->
    <style name="TextAppearance.ChatCircle.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/konecta_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Collapsing header title, expanded and pinned. -->
    <style name="TextAppearance.ChatCircle.CollapsedTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppinssemibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="TextAppearance.ChatCircle.ExpandedTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/poppinsbold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">30sp</item>
    </style>

    <!-- Section heading above a list, e.g. YOUR ROOMS. -->
    <style name="TextAppearance.ChatCircle.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/poppinssemibold</item>
        <item name="android:textColor">@color/konecta_ink</item>
        <item name="android:textSize">17sp</item>
    </style>


    <!-- Circular avatar mask, used for profile photos and people rows. -->
    <style name="ShapeAppearance.ChatCircle.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <!--
        The circular icon button used for header actions - the notification
        bell, search, back, settings. One style so every one of them is the
        same diameter and the same weight; they looked mismatched when each
        screen sized its own.
    -->
    <style name="Widget.ChatCircle.IconButton.Circle" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/konecta_neutral</item>
        <item name="cornerRadius">26dp</item>
        <item name="iconSize">26dp</item>
        <item name="iconTint">@color/konecta_blue</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:padding">13dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Same button, but sitting on the brand blue rather than on white. -->
    <style name="Widget.ChatCircle.IconButton.Circle.OnBrand">
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="iconTint">@color/white</item>
    </style>

</resources>
