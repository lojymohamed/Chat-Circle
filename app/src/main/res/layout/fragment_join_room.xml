<?xml version="1.0" encoding="utf-8"?>
<!--
    Join-room screen: a single code field with a scan shortcut.

    The layout is deliberately top-heavy - the brand mark and headline sit in
    the upper half and the input sits low, near the thumb. That is the shape of
    a "type one short thing and continue" screen, and it stops the field from
    being buried once the keyboard opens.

    RegisterFragment-style inset handling applies here too: the root carries
    fitsSystemWindows so the backdrop paints under the status bar while the
    content clears it.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/konecta_blue_soft"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        tools:context=".ui.rooms.JoinRoomFragment">

        <!-- Brand motif, bled off the top-left corner -->
        <ImageView
            android:id="@+id/decorN"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-90dp"
            android:layout_marginTop="-40dp"
            android:adjustViewBounds="true"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:rotation="-10"
            android:src="@drawable/ic_n_outline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/konecta_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/konecta_ink"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:text="@string/join_title"
            android:textAppearance="@style/TextAppearance.ChatCircle.Title"
            android:textSize="36sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/join_subtitle"
            android:textAppearance="@style/TextAppearance.ChatCircle.Subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!--
            Code field and scan button share one rounded surface, split by a
            hairline, so they read as a single control rather than a field with
            a button parked next to it.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/codeCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="@color/konecta_surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:strokeColor="@color/konecta_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etRoomCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppinsmedium"
                    android:hint="@string/join_code_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:letterSpacing="0.18"
                    android:maxLength="6"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="20dp"
                    android:singleLine="true"
                    android:textColor="@color/konecta_ink"
                    android:textColorHint="@color/konecta_muted"
                    android:textSize="17sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/konecta_outline" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnScan"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/join_scan_description"
                    android:padding="17dp"
                    app:srcCompat="@drawable/avd_qr_scan" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnter"
            style="@style/Widget.ChatCircle.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/join_action"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/codeCard" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:background="@color/konecta_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEnter" />

        <TextView
            android:id="@+id/tvCreateInstead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppinssemibold"
            android:padding="6dp"
            android:text="@string/join_create_instead"
            android:textColor="@color/konecta_blue"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCreateInstead"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
