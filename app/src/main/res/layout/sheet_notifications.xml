<?xml version="1.0" encoding="utf-8"?>
<!--
    Notifications sheet, opened from the bell on Home.

    There is no notifications collection in the backend, so this is derived
    from data the app already has: the rooms with unread messages. That keeps
    the bell honest - it only ever shows things that are really waiting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_mock_field" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/poppinsbold"
        android:text="@string/notifications_title"
        android:textColor="@color/konecta_ink"
        android:textSize="22sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notificationsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="380dp"
        android:paddingHorizontal="10dp"
        tools:itemCount="2"
        tools:listitem="@layout/item_chat_room" />

    <LinearLayout
        android:id="@+id/notificationsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="26dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinssemibold"
            android:text="@string/notifications_empty"
            android:textColor="@color/konecta_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/poppins"
            android:text="@string/notifications_empty_hint"
            android:textColor="@color/konecta_muted"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
