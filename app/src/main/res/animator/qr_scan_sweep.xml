<?xml version="1.0" encoding="utf-8"?>
<!--
    Slides the scan line between the top and bottom brackets, forever.

    repeatMode="reverse" is what makes it sweep back rather than snapping to
    the top and starting over - the snap reads as a glitch at this size.
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1100"
    android:interpolator="@android:interpolator/accelerate_decelerate"
    android:propertyName="translateY"
    android:repeatCount="infinite"
    android:repeatMode="reverse"
    android:valueFrom="-5"
    android:valueTo="5"
    android:valueType="floatType" />
