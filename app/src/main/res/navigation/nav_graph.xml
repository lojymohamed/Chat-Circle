<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <!--
        Onboarding is the start destination and gates on the session, not on a
        first-run flag: it runs on every launch for anyone who is not signed in,
        and OnboardingFragment forwards users with an active session straight to
        the room list.

        Every action pops onboarding off the back stack, so pressing back from
        login or the room list leaves the app rather than returning to the
        intro.
    -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.chatcircle.ui.onboarding.OnboardingFragment"
        android:label="Welcome">

        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

        <!-- Taken when a session is already active, so the intro is skipped -->
        <action
            android:id="@+id/action_onboardingFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.chatcircle.ui.auth.login.LoginFragment"
        android:label="Login">

        <!-- Requirement 1: Login → Register -->
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <!-- Requirement 2: Login → Chat Rooms -->
        <action
            android:id="@+id/action_loginFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.chatcircle.ui.auth.register.RegisterFragment"
        android:label="Register" />

    <fragment
        android:id="@+id/chatRoomFragment"
        android:name="com.example.chatcircle.ui.rooms.ChatRoomFragment">
        <action
            android:id="@+id/action_chatRoomFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_chatRoomFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.chatcircle.ui.chat.ChatFragment">
        <argument android:name="roomId" app:argType="string" />
        <argument android:name="roomName" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.chatcircle.ui.profile.ProfileFragment"
        android:label="Profile">
        <!-- Sign out action clears the back stack -->
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
